# Where the tables come from: "supabase" (REST API, default) or "csv" (local gzipped export, offline)
DATA_SOURCE=supabase

# Your Supabase project (dashboard -> Project Settings -> API Keys). The publishable/anon key is enough (read-only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_xxx

# Only used when DATA_SOURCE=csv: folder that holds the instructor's SENTINEL tables
# (the one containing customers/, merchants/, devices/, transactions/, payment_outcomes/, labels/, features/)
DATA_DIR=supabase_db_kit/data/tables
